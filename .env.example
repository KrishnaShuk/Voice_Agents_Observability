# Copy to `.env` at the repo root and fill in. `.env` is gitignored; never commit it.
#
#   cp .env.example .env
#
# The dev/start scripts auto-load this file:
#   pnpm --filter ingest dev
#   pnpm --filter agent dev
#   pnpm --filter agent web
#   pnpm --filter ingest fake-events

# ---- LiveKit (required for the agent worker + join page) ----
# Option A (no account): the local `livekit` docker-compose service uses fixed dev keys.
# These values already match `docker compose up -d livekit`.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Option B (LiveKit Cloud): replace the three values above with your project's
# wss://<project>.livekit.cloud URL, API key, and API secret from cloud.livekit.io.
# Agent dispatch name — must match between the worker and the join-page token.
LIVEKIT_AGENT_NAME=voxobs

# ---- Model providers (required for a real call) ----
DEEPGRAM_API_KEY=
GROQ_API_KEY=
# TTS provider: "deepgram" (Aura, reuses DEEPGRAM_API_KEY, free-credit friendly)
# or "elevenlabs" (needs a key with text_to_speech + voices_read permissions and,
# for library voices, a paid plan).
TTS_PROVIDER=deepgram
# Optional overrides
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=qwen/qwen3.8-27b
# LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# STT_FALLBACK_MODEL=nova-2-general
# TTS_FALLBACK_MODEL=aura-2-orpheus-en
# ELEVEN_API_KEY=
# ELEVEN_VOICE_ID=
# AGENT_VERSION=0.0.0

# ---- Failover (M4) ----
# Off by default: the single-provider path is stable. Set FAILOVER=1 to wrap each
# stage in a FallbackAdapter with latency guardrails (opt-in; live tuning pending).
# FAILOVER=1
# Latency guardrails (ms); a breach rotates to the fallback provider.
# GUARDRAIL_TTFT_MS=8000
# GUARDRAIL_TTFB_MS=8000
# GUARDRAIL_STT_FINAL_MS=4000
# GUARDRAIL_CONSECUTIVE=2
# GUARDRAIL_RECOVER_AFTER=3
# Secret header for POST /simulate-failure on the agent web service.
INJECTION_TOKEN=dev-injection-token

# ---- Pipeline ----
# Shared secret between the SDK and ingest (must match on both sides)
INGEST_API_KEY=dev-key
# Where the SDK sends events
INGEST_WS_URL=ws://localhost:4000/ingest
# Ingest Postgres / HTTP
DATABASE_URL=postgres://vox:vox@localhost:5432/vox_observability
PORT=4000
# Join page
WEB_PORT=3001

# ---- Dashboard (M5) ----
# Where the live view subscribes (WS /live on ingest)
NEXT_PUBLIC_INGEST_LIVE_URL=ws://localhost:4000/live
# REST base for history/replay (GET /sessions, /sessions/:id/events)
NEXT_PUBLIC_INGEST_HTTP_URL=http://localhost:4000
# Link shown in the empty state
NEXT_PUBLIC_JOIN_URL=http://localhost:3001
