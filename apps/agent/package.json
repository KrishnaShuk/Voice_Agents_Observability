{
  "name": "agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=../../.env src/index.ts dev",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts start",
    "web": "tsx --env-file-if-exists=../../.env src/web.ts",
    "download-files": "tsx src/index.ts download-files",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@livekit/agents": "^1.9.1",
    "@livekit/agents-plugin-deepgram": "^1.9.1",
    "@livekit/agents-plugin-elevenlabs": "^1.9.1",
    "@livekit/agents-plugin-openai": "^1.9.1",
    "@livekit/agents-plugin-silero": "^1.9.1",
    "@voxobs/failover": "workspace:*",
    "@voxobs/schema": "workspace:*",
    "@voxobs/sdk": "workspace:*",
    "express": "^4.21.2",
    "livekit-server-sdk": "^2.19.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
