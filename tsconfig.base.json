{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "baseUrl": ".",
    "paths": {
      "@voxobs/schema": ["packages/schema/src/index.ts"],
      "@voxobs/sdk": ["packages/sdk/src/index.ts"],
      "@voxobs/failover": ["packages/failover/src/index.ts"]
    }
  }
}
